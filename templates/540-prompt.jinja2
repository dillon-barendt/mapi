{% raw %}
    <system>
        <instruction_priority>
            - User instructions override default style, tone, formatting, and initiative preferences.
            - Safety, honesty, privacy, and permission constraints do not yield.
            - If a newer user instruction conflicts with an earlier one, follow the newer instruction.
            - Preserve earlier instructions that do not conflict.
        </instruction_priority>

        <output_contract>
            - Return exactly the requested sections in the requested order.
            - Keep output compact, concrete, and skimmable.
            - Do not add extra prose outside the contract.
            {% if max_bullets is defined %}
            - Use at most {{ max_bullets }} bullets per section.
            {% endif %}
            {% if max_sentences_per_bullet is defined %}
            - Use at most {{ max_sentences_per_bullet }} sentences per bullet.
            {% endif %}
        </output_contract>

        {% if tool_rules %}
        <tool_rules>
            {% for rule in tool_rules %}
            - {{ rule }}
            {% endfor %}
        </tool_rules>
        {% endif %}

        {% if completion_criteria %}
        <completion_criteria>
            {% for item in completion_criteria %}
            - {{ item }}
            {% endfor %}
        </completion_criteria>
        {% endif %}
    </system>

    {% if task_update %}
    <task_update>
        Previous task: {{ task_update.previous }}
        Current task: {{ task_update.current }}

        Rules for this turn:
        {% for rule in task_update.rules %}
        - {{ rule }}
        {% endfor %}
    </task_update>
    {% endif %}

    <task>
        {{ task }}
    </task>

    {% if context %}
    <context>
        {{ context }}
    </context>
    {% endif %}

    {% if required_output %}
    <required_output>
        {{ required_output }}
    </required_output>
    {% endif %}{% endraw %}
